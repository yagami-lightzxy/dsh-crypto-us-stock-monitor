{
  "name": "dsh-crypto-us-stock-monitor",
  "version": "0.15.0",
  "description": "DSH Desktop 加密货币与美股监控插件：自选行情、技术指标、市场情绪、信号提醒，以及 Agent 自选与目标价管理",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "crypto",
    "us-stocks",
    "watchlist",
    "market-monitor",
    "technical-analysis"
  ],
  "bin": {
    "dsh-market-monitor": "./bin/monitor.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yagami-lightzxy/dsh-crypto-us-stock-monitor.git"
  },
  "homepage": "https://github.com/yagami-lightzxy/dsh-crypto-us-stock-monitor"
}
