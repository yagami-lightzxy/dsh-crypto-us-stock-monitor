{
  "name": "dsh-binance-bitget-watchlist",
  "version": "0.12.2",
  "description": "加密美股监控（Crypto × US Stock Monitor）：DSH 左下角加密/美股自选、技术面、市场宽度与情绪面板",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "crypto",
    "us-stocks",
    "watchlist",
    "market-monitor",
    "technical-analysis"
  ]
}
